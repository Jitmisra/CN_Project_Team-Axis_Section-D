# standby-edge/nginx-standby.conf.tmpl — Standby Edge Nginx Server Block (Mac 3)
upstream standby_backend_pool {
    # Backend A is local on this machine (Mac 3) via loopback
    server 127.0.0.1:3001 max_fails=2 fail_timeout=5s;
    # Backend B is on Mac 4 (Anwesha)
    server __MAC4_IP__:3002 max_fails=2 fail_timeout=5s;
}

server {
    listen 8080;
    server_name app.cnteam.test api.cnteam.test;
    return 301 https://$host:8443$request_uri;
}

server {
    listen 8443 ssl;
    server_name app.cnteam.test api.cnteam.test;

    ssl_certificate     __CERT_PATH__;
    ssl_certificate_key __KEY_PATH__;

    # Edge identity header indicating response is served by Mac 3 Standby Edge
    add_header X-Edge "mac3-standby" always;

    location / {
        proxy_pass http://standby_backend_pool;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_connect_timeout 2s;
    }
}
