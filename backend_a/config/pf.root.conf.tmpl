# config/pf.root.conf.tmpl — Main PF configuration including Apple defaults + cnteam anchor
# Preserve Apple system anchors
scrub-anchor "com.apple/*"
nat-anchor "com.apple/*"
rdr-anchor "com.apple/*"
dummynet-anchor "com.apple/*"
anchor "com.apple/*"
load anchor "com.apple" from "/etc/pf.anchors/com.apple"

# Team Service Isolation Anchor
anchor "cnteam"
load anchor "cnteam" from "__ANCHOR_PATH__"
