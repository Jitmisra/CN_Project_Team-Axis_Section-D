# ==== CN project (Team Axis): nginx EDGE, rendered from config/edge.conf.tmpl ====
# One template, two edges (Phase 2 Ext E needs "the same configuration" on the standby):
#   mac2-primary : Mac 2 (Agnik)   rendered by scripts/d-install-nginx.sh
#   mac3-standby : Mac 3 (Vishuti) rendered by standby-edge/install-standby.sh
# This edge: @EDGE_NAME@
# Ports 8080/8443 instead of 80/443: Homebrew nginx runs without sudo (allowed by the course).
# This file is included inside nginx.conf's http { } block (include servers/*;).

# Edge access log: shows which backend served each request and any retries.
# $upstream_addr = "A_IP:3001, B_IP:3002" means nginx tried A, it failed, and nginx retried on B
# inside the SAME client request (Ext D evidence). Backend IPs stay in this log only, never in a
# response header: clients must not learn backend addresses.
log_format cnteam_edge '$time_iso8601 client=$remote_addr "$request" status=$status '
                       'upstream=$upstream_addr ustatus=$upstream_status urt=$upstream_response_time '
                       'http=$server_protocol tls=$ssl_protocol edge=@EDGE_NAME@';

upstream backend_pool {
    # Round-robin (nginx default). PASSIVE health check (nginx open source has no active probes):
    # one failed connection/timeout marks a backend unavailable for 10 s. After that, real traffic
    # tries it again, so a restarted backend rejoins within <= 10 s.
    server @BACKEND_A@ max_fails=1 fail_timeout=10s;   # Backend A (Vishuti, Mac 3, :3001)
    server @BACKEND_B@ max_fails=1 fail_timeout=10s;   # Backend B (Anwesha, Mac 4, :3002)
}

# Plain HTTP: redirect to HTTPS.
server {
    listen @HTTP_PORT@;
    server_name app.@DOMAIN@ api.@DOMAIN@;
    add_header X-Edge "@EDGE_NAME@" always;
    return 301 https://$host:@HTTPS_PORT@$request_uri;
}

# HTTPS: TLS terminates here, then plain HTTP to the backends inside the LAN.
server {
    listen @HTTPS_PORT@ ssl;
    http2 on;                                   # HTTP/2 negotiated via ALPN ("h2") in the TLS handshake
    server_name app.@DOMAIN@ api.@DOMAIN@;

    ssl_certificate     @CERT@;
    ssl_certificate_key @KEY@;                  # private key: never committed to git

    access_log @ACCESS_LOG@ cnteam_edge;

    location / {
        proxy_pass http://backend_pool;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;

        # Failover (Ext D): on a refused connection, timeout or 502/503/504, retry the request on
        # the other backend (at most 2 attempts in total) so the client never sees the failure.
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        proxy_connect_timeout 2s;               # silent/dead host: give up on it after 2 s
        proxy_read_timeout 5s;

        # Which edge answered (Ext E cutover). "always" keeps it on 502/504 too, which proves the
        # edge itself was reached even when the backends weren't.
        add_header X-Edge "@EDGE_NAME@" always;
    }
}
